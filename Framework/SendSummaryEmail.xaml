  <Sequence sap2010:Annotation.AnnotationText="End-of-run summary for Procurement Operations: eligible, completed, rejected and failed counts, with the processing report attached.&#xA;Counts come from the report, which holds exactly one row per Request ID with its FINAL status, so queue retries are never double-counted. Only rows written during this run (timestamp at or after in_RunStart) are counted." DisplayName="SendSummaryEmail" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtReport" />
      <Variable x:TypeArguments="scg:List(sd:DataRow)" sap2010:Annotation.AnnotationText="Report rows written during this run." Name="lstRunRows" />
      <Variable x:TypeArguments="x:Int32" Name="intEligible" />
      <Variable x:TypeArguments="x:Int32" Name="intCompleted" />
      <Variable x:TypeArguments="x:Int32" Name="intRejected" />
      <Variable x:TypeArguments="x:Int32" Name="intFailed" />
      <Variable x:TypeArguments="x:String" Name="strSubject" />
      <Variable x:TypeArguments="x:String" Name="strBody" />
      <Variable x:TypeArguments="x:String" sap2010:Annotation.AnnotationText="Outlook needs an absolute path for attachments." Name="strReportFullPath" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[dtReport]" DisplayName="Read processing report" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="[in_Config(&quot;ReportSheetName&quot;).ToString]" WorkbookPath="[in_Config(&quot;ReportFilePath&quot;).ToString]" />
    <Assign sap2010:Annotation.AnnotationText="Timestamps are written as yyyy-MM-dd HH:mm:ss, which sorts as text, so a plain string compare finds this run's rows without any date parsing that could fail on a bad cell." DisplayName="Select rows of this run" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="scg:List(sd:DataRow)">[lstRunRows]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="scg:List(sd:DataRow)">[dtReport.AsEnumerable().Where(Function(r) String.Compare(r(&quot;Processing Timestamp&quot;).ToString.Trim, in_RunStart.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;), StringComparison.Ordinal) &gt;= 0).ToList()]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Eligible = requests the Performer processed to a final outcome in this run (requests skipped as already completed keep their old row and are not counted)." DisplayName="Count eligible" sap2010:WorkflowViewState.IdRef="Assign_2">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intEligible]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[lstRunRows.Count]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Count Completed" sap2010:WorkflowViewState.IdRef="Assign_3">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intCompleted]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[lstRunRows.Where(Function(r) r(&quot;Final Status&quot;).ToString.Trim = &quot;Completed&quot;).Count]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Count Rejected" sap2010:WorkflowViewState.IdRef="Assign_4">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intRejected]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[lstRunRows.Where(Function(r) r(&quot;Final Status&quot;).ToString.Trim = &quot;Rejected&quot;).Count]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Count Failed" sap2010:WorkflowViewState.IdRef="Assign_5">
      <Assign.To>
        <OutArgument x:TypeArguments="x:Int32">[intFailed]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:Int32">[lstRunRows.Where(Function(r) r(&quot;Final Status&quot;).ToString.Trim = &quot;Failed&quot;).Count]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Get absolute report path" sap2010:WorkflowViewState.IdRef="Assign_6">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strReportFullPath]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[Path.GetFullPath(in_Config(&quot;ReportFilePath&quot;).ToString)]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign DisplayName="Build summary subject" sap2010:WorkflowViewState.IdRef="Assign_7">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strSubject]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Format(in_Config(&quot;EmailSubject_Summary&quot;).ToString, Now.ToString(&quot;yyyy-MM-dd HH:mm&quot;))]</InArgument>
      </Assign.Value>
    </Assign>
    <Assign sap2010:Annotation.AnnotationText="Template placeholders: {0} eligible, {1} completed, {2} rejected, {3} failed." DisplayName="Build summary body" sap2010:WorkflowViewState.IdRef="Assign_8">
      <Assign.To>
        <OutArgument x:TypeArguments="x:String">[strBody]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="x:String">[String.Format(in_Config(&quot;EmailBody_Summary&quot;).ToString, intEligible, intCompleted, intRejected, intFailed)]</InArgument>
      </Assign.Value>
    </Assign>
    <ui:SendOutlookMail Bcc="{x:Null}" Cc="{x:Null}" ContinueOnError="{x:Null}" MailMessage="{x:Null}" ReplyTo="{x:Null}" TimeoutMS="{x:Null}" UseRichTextEditor="{x:Null}" Account="[in_Config(&quot;OutlookAccount&quot;).ToString]" Body="[strBody]" ConnectionMode="Undefined" CreatedAfterSolutionSupport="False" sap2010:Annotation.AnnotationText="Summary to the Procurement Operations mailbox (Config: ProcurementMailbox) with the processing report attached. Sent via the Outlook desktop profile (Config: OutlookAccount)." DisplayName="Send summary email" sap:VirtualizedContainerService.HintSize="451.2,217.6" sap2010:WorkflowViewState.IdRef="SendOutlookMail_1" Importance="Normal" IsBodyHtml="True" IsDraft="False" Sensitivity="Normal" Subject="[strSubject]" To="[in_Config(&quot;ProcurementMailbox&quot;).ToString]" UseISConnection="False">
                          <ui:SendOutlookMail.ConnectionDetailsBackupSlot>
