  <Sequence sap2010:Annotation.AnnotationText="Notifies the employee about the outcome of one request: confirmation for Completed, reason for Rejected.&#xA;Subjects and bodies are templates in Config (Constants sheet), so wording changes need no code change.&#xA;Called from SetTransactionStatus AFTER the report is written, inside a Try Catch: an email failure never changes the outcome or causes a second purchase." DisplayName="SendEmployeeEmail" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
