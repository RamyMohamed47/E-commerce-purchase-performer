                  </Assign.Value>
                </Assign>
                <Assign sap2010:Annotation.AnnotationText="Template placeholders: {0} name, {1} Request ID, {2} product, {3} converted price, {4} currency." DisplayName="Build completed body" sap2010:WorkflowViewState.IdRef="Assign_3">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strBody]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[String.Format(in_Config(&quot;EmailBody_Completed&quot;).ToString, funcGet(&quot;EmployeeName&quot;), in_RequestId, funcGet(&quot;ProductName&quot;), If(in_TransactionResult.ContainsKey(&quot;ConvertedPrice&quot;), CDec(in_TransactionResult(&quot;ConvertedPrice&quot;)).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture), &quot;&quot;), funcGet(&quot;PreferredCurrency&quot;))]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Then>
            <If.Else>
              <Sequence DisplayName="Rejected email" sap2010:WorkflowViewState.IdRef="Sequence_5">
                <Assign DisplayName="Build rejected subject" sap2010:WorkflowViewState.IdRef="Assign_4">
