                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[String.Format(in_Config(&quot;EmailSubject_Rejected&quot;).ToString, in_RequestId)]</InArgument>
                  </Assign.Value>
                </Assign>
                <Assign sap2010:Annotation.AnnotationText="Template placeholders: {0} name, {1} Request ID, {2} product, {3} rejection reason. Fallback words when the request was rejected before name/product were known." DisplayName="Build rejected body" sap2010:WorkflowViewState.IdRef="Assign_5">
                  <Assign.To>
                    <OutArgument x:TypeArguments="x:String">[strBody]</OutArgument>
                  </Assign.To>
                  <Assign.Value>
                    <InArgument x:TypeArguments="x:String">[String.Format(in_Config(&quot;EmailBody_Rejected&quot;).ToString, If(funcGet(&quot;EmployeeName&quot;) = &quot;&quot;, &quot;colleague&quot;, funcGet(&quot;EmployeeName&quot;)), in_RequestId, If(funcGet(&quot;ProductName&quot;) = &quot;&quot;, &quot;your requested product&quot;, funcGet(&quot;ProductName&quot;)), in_StatusReason)]</InArgument>
                  </Assign.Value>
                </Assign>
              </Sequence>
            </If.Else>
