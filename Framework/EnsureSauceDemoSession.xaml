  <Sequence sap2010:Annotation.AnnotationText="SauceDemo logs a session out after about 10 minutes. Called at the start of every new transaction: opens the inventory page and, if the session expired (redirected to login), logs in again through the shared LoginSauceDemo workflow.&#xA;Avoids burning a queue retry just because the session timed out." DisplayName="EnsureSauceDemoSession" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="x:Boolean" sap2010:Annotation.AnnotationText="True when the Products page showed up, i.e. the session is still logged in." Name="boolSessionActive" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <uix:NApplicationCard sap2010:Annotation.AnnotationText="Only CHECKS the session. The login itself runs after this card closes, so the shared login workflow (which has its own card) is never nested inside another card." AttachMode="ByInstance" CloseMode="[UiPath.UIAutomationNext.Enums.NAppCloseMode.Never]" DisplayName="Attach to SauceDemo browser" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" InUiElement="[in_SauceDemoBrowser]" InteractionMode="DebuggerApi" OpenMode="[UiPath.UIAutomationNext.Enums.NAppOpenMode.Never]" ScopeGuid="eca4a704-b0f7-4038-b9d7-580ad9301400" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <uix:NGoToUrl sap2010:Annotation.AnnotationText="A logged-in session shows the product list; an expired one is redirected to the login page." DisplayName="Go to inventory page" sap2010:WorkflowViewState.IdRef="NGoToUrl_1" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Url="[in_Config(&quot;SauceDemoURL&quot;).ToString &amp; &quot;inventory.html&quot;]" Version="V5" />
            <uix:NCheckState sap2010:Annotation.AnnotationText="'Products' title visible = still logged in. Short timeout: the page is already loaded by Go To URL." DisplayName="Check if still logged in ('Products')" HealingAgentBehavior="Disabled" sap2010:WorkflowViewState.IdRef="NCheckState_1" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Timeout="5" Version="V5">
              <uix:NCheckState.IfExists>
                <Sequence DisplayName="Session active" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <Assign DisplayName="Session active = True" sap2010:WorkflowViewState.IdRef="Assign_1">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Boolean">[boolSessionActive]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Boolean">True</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </uix:NCheckState.IfExists>
              <uix:NCheckState.IfNotExists>
                <Sequence DisplayName="Session expired" sap2010:WorkflowViewState.IdRef="Sequence_4">
                  <Assign DisplayName="Session active = False" sap2010:WorkflowViewState.IdRef="Assign_2">
                    <Assign.To>
                      <OutArgument x:TypeArguments="x:Boolean">[boolSessionActive]</OutArgument>
                    </Assign.To>
                    <Assign.Value>
                      <InArgument x:TypeArguments="x:Boolean">False</InArgument>
                    </Assign.Value>
                  </Assign>
                </Sequence>
              </uix:NCheckState.IfNotExists>
              <uix:NCheckState.Target>
                <uix:TargetAnchorable BrowserURL="saucedemo.com/inventory.html" ContentHash="i3wPYpPN20atYvpOdcyxeQ" DesignTimeRectangle="39, 185, 96, 60" ElementType="Text" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl aaname='Products' data-test='title' tag='SPAN' /&gt;" Guid="93281675-f729-486c-87c3-e4591e95e4cb" InformativeScreenshot="2d777a31e3c8ff68b23eb4db64f92f4b.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/pSp8UqBTbUir48AE4TSlAQ" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NCheckState.Target>
            </uix:NCheckState>
          </Sequence>
        </ActivityAction>
      </uix:NApplicationCard.Body>
      <uix:NApplicationCard.OCREngine>
