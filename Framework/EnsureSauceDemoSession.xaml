  <Sequence sap2010:Annotation.AnnotationText="SauceDemo logs a session out after about 10 minutes. Called at the start of every new transaction: opens the inventory page and, if the session expired (redirected to login), logs in again with the same credential and checks as InitAllApplications.&#xA;Avoids burning a queue retry just because the session timed out. A failed re-login is still a system exception, so the framework restarts the browser." DisplayName="EnsureSauceDemoSession" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <uix:NApplicationCard sap2010:Annotation.AnnotationText="Attaches to the browser opened by InitAllApplications (Input element). Open/Close = Never." AttachMode="ByInstance" CloseMode="[UiPath.UIAutomationNext.Enums.NAppCloseMode.Never]" DisplayName="Attach to SauceDemo browser" HealingAgentBehavior="Job" sap2010:WorkflowViewState.IdRef="NApplicationCard_1" InUiElement="[in_SauceDemoBrowser]" InteractionMode="DebuggerApi" OpenMode="[UiPath.UIAutomationNext.Enums.NAppOpenMode.Never]" ScopeGuid="eca4a704-b0f7-4038-b9d7-580ad9301400" Version="V2">
      <uix:NApplicationCard.Body>
        <ActivityAction x:TypeArguments="x:Object">
          <ActivityAction.Argument>
            <DelegateInArgument x:TypeArguments="x:Object" Name="WSSessionData" />
          </ActivityAction.Argument>
          <Sequence DisplayName="Do" sap2010:WorkflowViewState.IdRef="Sequence_2">
            <uix:NGoToUrl sap2010:Annotation.AnnotationText="A logged-in session shows the product list; an expired one is redirected to the login page." DisplayName="Go to inventory page" sap2010:WorkflowViewState.IdRef="NGoToUrl_1" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Url="[in_Config(&quot;SauceDemoURL&quot;).ToString &amp; &quot;inventory.html&quot;]" Version="V5" />
            <uix:NCheckState sap2010:Annotation.AnnotationText="'Products' title visible = still logged in. Short timeout: the page is already loaded by Go To URL." DisplayName="Check if still logged in ('Products')" HealingAgentBehavior="Disabled" sap2010:WorkflowViewState.IdRef="NCheckState_1" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Timeout="5" Version="V5">
              <uix:NCheckState.IfExists>
                <Sequence DisplayName="Session active" sap2010:WorkflowViewState.IdRef="Sequence_3">
                  <ui:LogMessage DisplayName="Log session active" sap2010:WorkflowViewState.IdRef="LogMessage_1" Level="Trace" Message="[&quot;SauceDemo session active.&quot;]" />
                </Sequence>
              </uix:NCheckState.IfExists>
              <uix:NCheckState.IfNotExists>
                <Sequence sap2010:Annotation.AnnotationText="Same steps as InitAllApplications. The credential is read here, inside the browser scope, so the SecureString never leaves it (ST-SEC-008)." DisplayName="Session expired - log in again" sap2010:WorkflowViewState.IdRef="Sequence_4">
                  <Sequence.Variables>
                    <Variable x:TypeArguments="x:String" Name="strUsername" />
                    <Variable x:TypeArguments="ss:SecureString" Name="secPassword" />
                    <Variable x:TypeArguments="x:String" Name="strLoginError" />
                  </Sequence.Variables>
                  <ui:LogMessage DisplayName="Log session expired" sap2010:WorkflowViewState.IdRef="LogMessage_2" Level="Info" Message="[&quot;SauceDemo session expired - logging in again.&quot;]" />
                  <ui:GetRobotCredential TimeoutMS="{x:Null}" AssetName="[in_Config(&quot;SauceDemoCredential&quot;).ToString]" CacheStrategy="None" DisplayName="Get SauceDemo credential" FolderPath="[in_Config(&quot;OrchestratorQueueFolder&quot;).ToString]" sap2010:WorkflowViewState.IdRef="GetRobotCredential_1" Password="[secPassword]" Username="[strUsername]" />
                  <uix:NTypeInto ActivateBefore="True" ClickBeforeMode="Single" DisplayName="Type username" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NTypeInto_1" InteractionMode="SameAsCard" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Text="[strUsername]" Version="V5">
                    <uix:NTypeInto.Target>
                      <uix:TargetAnchorable BrowserURL="saucedemo.com" ContentHash="LPrGoQ-DOkOIXSlU3v9ZGA" DesignTimeRectangle="627, 301, 365, 48" ElementType="InputBox" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl id='user-name' tag='INPUT' /&gt;" Guid="96f20d55-e1b0-4989-8c3e-edcd3482bc50" InformativeScreenshot="e5a0144a85afa56e8214940ed7ddb79d.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/d3r8WaWc7UqNNgNoXuxjTw" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NTypeInto.Target>
                  </uix:NTypeInto>
                  <uix:NTypeInto ActivateBefore="True" ClickBeforeMode="Single" DisplayName="Type password" EmptyFieldMode="SingleLine" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NTypeInto_2" InteractionMode="SameAsCard" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" SecureText="[secPassword]" Version="V5">
                    <uix:NTypeInto.Target>
                      <uix:TargetAnchorable BrowserURL="saucedemo.com" ContentHash="MGNlJSQK70-MDapJBRbz5A" DesignTimeRectangle="627, 368, 365, 48" ElementType="InputBoxPassword" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl id='password' tag='INPUT' /&gt;" Guid="b961e76c-8c1b-44d7-972c-148a574e53ad" InformativeScreenshot="be1bd318e8dd6fdf002e523ff9262741.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/iOUYFX2lG0SMcyykJWWQww" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NTypeInto.Target>
