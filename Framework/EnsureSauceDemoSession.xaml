                    <uix:NClick.Target>
                      <uix:TargetAnchorable BrowserURL="saucedemo.com" ContentHash="u3AvZIeLskWrdkicLxDXBA" DesignTimeRectangle="627, 485, 365, 61" ElementType="Button" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl id='login-button' tag='INPUT' /&gt;" Guid="c8e4f653-c60a-465d-814b-bdcb57033288" InformativeScreenshot="225907b65a9659ad732801710c487e98.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/X0uXGR_5WkGOLLa9ZSL01A" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NClick.Target>
                  </uix:NClick>
                  <uix:NCheckState DisplayName="Check re-login succeeded ('Products')" HealingAgentBehavior="Disabled" sap2010:WorkflowViewState.IdRef="NCheckState_2" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" Timeout="10" Version="V5">
                    <uix:NCheckState.IfExists>
                      <Sequence DisplayName="Logged in again" sap2010:WorkflowViewState.IdRef="Sequence_5">
                        <ui:LogMessage DisplayName="Log re-login succeeded" sap2010:WorkflowViewState.IdRef="LogMessage_3" Level="Info" Message="[&quot;SauceDemo re-login succeeded.&quot;]" />
                      </Sequence>
                    </uix:NCheckState.IfExists>
                    <uix:NCheckState.IfNotExists>
                      <Sequence DisplayName="Re-login failed" sap2010:WorkflowViewState.IdRef="Sequence_6">
                        <uix:NGetText sap2010:Annotation.AnnotationText="Read the red error banner; continues on error so the Throw below still runs when no banner is shown." ContinueOnError="True" DisplayName="Get login error message" HealingAgentBehavior="SameAsCard" sap2010:WorkflowViewState.IdRef="NGetText_1" ScopeIdentifier="eca4a704-b0f7-4038-b9d7-580ad9301400" TextString="[strLoginError]" Timeout="5" Version="V5">
                          <uix:NGetText.Target>
                            <uix:TargetAnchorable ContentHash="NfO3yYHzokqLiVuLrLDGDA" DesignTimeRectangle="639, 425, 340, 50" ElementType="Text" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl aria-label='Login' tag='FORM' /&gt;&lt;webctrl aria-role='alert' tag='H3' /&gt;" Guid="9273bc20-2113-4ebc-b09f-a304b66765e1" InformativeScreenshot="bf039adcbd44283549cab3a4b2b9930e.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/e9XEEMNkqku_XLsfiBg0Hg" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                          </uix:NGetText.Target>
                        </uix:NGetText>
                        <Throw sap2010:Annotation.AnnotationText="System exception: the framework closes/kills the browser and InitAllApplications logs in from scratch on the retry." DisplayName="Throw system exception (re-login failed)" Exception="[New Exception(&quot;SauceDemo re-login failed: &quot; &amp; If(String.IsNullOrWhiteSpace(strLoginError), &quot;the Products page did not load and no error message was shown.&quot;, strLoginError.Trim))]" sap2010:WorkflowViewState.IdRef="Throw_1" />
                      </Sequence>
                    </uix:NCheckState.IfNotExists>
                    <uix:NCheckState.Target>
                      <uix:TargetAnchorable BrowserURL="saucedemo.com/inventory.html" ContentHash="i3wPYpPN20atYvpOdcyxeQ" DesignTimeRectangle="39, 185, 96, 60" ElementType="Text" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl aaname='Products' data-test='title' tag='SPAN' /&gt;" Guid="93281675-f729-486c-87c3-e4591e95e4cb" InformativeScreenshot="2d777a31e3c8ff68b23eb4db64f92f4b.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/pSp8UqBTbUir48AE4TSlAQ" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
                    </uix:NCheckState.Target>
                  </uix:NCheckState>
                </Sequence>
              </uix:NCheckState.IfNotExists>
              <uix:NCheckState.Target>
                <uix:TargetAnchorable BrowserURL="saucedemo.com/inventory.html" ContentHash="i3wPYpPN20atYvpOdcyxeQ" DesignTimeRectangle="39, 185, 96, 60" ElementType="Text" ElementVisibilityArgument="Interactive" FullSelectorArgument="&lt;webctrl aaname='Products' data-test='title' tag='SPAN' /&gt;" Guid="93281675-f729-486c-87c3-e4591e95e4cb" InformativeScreenshot="2d777a31e3c8ff68b23eb4db64f92f4b.jpg" Reference="Y6t2V4z8mESCz6OvpfNcaw/pSp8UqBTbUir48AE4TSlAQ" ScopeSelectorArgument="&lt;html app='msedge.exe' title='Swag Labs' /&gt;" SearchSteps="Selector" Version="V6" WaitForReadyArgument="Interactive" />
              </uix:NCheckState.Target>
            </uix:NCheckState>
          </Sequence>
        </ActivityAction>
