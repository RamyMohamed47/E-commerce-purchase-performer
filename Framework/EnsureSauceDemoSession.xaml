          <ui:InvokeWorkflowFile ArgumentsVariable="{x:Null}" sap2010:Annotation.AnnotationText="Same login as InitAllApplications. A failed re-login throws a system exception, so the framework restarts the browser and retries." DisplayName="Invoke LoginSauceDemo workflow" sap2010:WorkflowViewState.IdRef="InvokeWorkflowFile_1" UnSafe="False" WorkflowFileName="Framework\LoginSauceDemo.xaml">
