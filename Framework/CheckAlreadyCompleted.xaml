  <Sequence sap2010:Annotation.AnnotationText="Looks up the Request ID in the processing report. Used by Process so a request that was already completed (e.g. re-dispatched or retried after checkout) is never purchased twice." DisplayName="CheckAlreadyCompleted" sap:VirtualizedContainerService.HintSize="767.6,415.2" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" Name="dtReport" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadRange sap2010:Annotation.AnnotationText="Whole sheet, headers on. Report columns are text, so values compare as strings. InitReport guarantees the file exists." Range="{x:Null}" AddHeaders="True" DataTable="[dtReport]" DisplayName="Read processing report" sap:VirtualizedContainerService.HintSize="449.6,226.4" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="[in_Config(&quot;ReportSheetName&quot;).ToString]" WorkbookPath="[in_Config(&quot;ReportFilePath&quot;).ToString]" />
    <Assign sap2010:Annotation.AnnotationText="Only Completed counts: Rejected or Failed rows may be processed again (e.g. after the data is fixed). Status compare ignores case; values are trimmed." DisplayName="Check report for Completed row" sap:VirtualizedContainerService.HintSize="449.6,165.6" sap2010:WorkflowViewState.IdRef="Assign_1">
