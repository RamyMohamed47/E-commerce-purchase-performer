  <Sequence sap2010:Annotation.AnnotationText="Writes ONE report row per Request ID for every outcome (Completed / Rejected / Failed). Upsert: updates the existing row when the Request ID is already in the report, otherwise adds a new one, so reruns and queue retries never create duplicates.&#xA;Called from SetTransactionStatus, the one place that runs for every outcome." DisplayName="UpdateReport" sap2010:WorkflowViewState.IdRef="Sequence_1">
    <Sequence.Variables>
      <Variable x:TypeArguments="sd:DataTable" sap2010:Annotation.AnnotationText="Whole report sheet." Name="dtReport" />
      <Variable x:TypeArguments="sd:DataRow" sap2010:Annotation.AnnotationText="The row for this Request ID (existing or newly added)." Name="drRow" />
      <Variable x:TypeArguments="s:Func(x:String, x:String)" sap2010:Annotation.AnnotationText="Reads a TransactionResult value as text, or empty when the key is missing (e.g. the request was rejected before the price step). InvariantCulture keeps decimals as 29.99 on any robot locale." Default="[Function(k As String) If(in_TransactionResult IsNot Nothing AndAlso in_TransactionResult.ContainsKey(k) AndAlso in_TransactionResult(k) IsNot Nothing, Convert.ToString(in_TransactionResult(k), CultureInfo.InvariantCulture), &quot;&quot;)]" Name="funcGet" />
    </Sequence.Variables>
    <sap:WorkflowViewStateService.ViewState>
      <scg:Dictionary x:TypeArguments="x:String, x:Object">
        <x:Boolean x:Key="IsExpanded">True</x:Boolean>
        <x:Boolean x:Key="IsAnnotationDocked">True</x:Boolean>
      </scg:Dictionary>
    </sap:WorkflowViewStateService.ViewState>
    <ui:ReadRange Range="{x:Null}" AddHeaders="True" DataTable="[dtReport]" DisplayName="Read processing report" sap2010:WorkflowViewState.IdRef="ReadRange_1" SheetName="[in_Config(&quot;ReportSheetName&quot;).ToString]" WorkbookPath="[in_Config(&quot;ReportFilePath&quot;).ToString]" />
    <Assign sap2010:Annotation.AnnotationText="Upsert key: the Request ID (trimmed text compare; all report columns are text)." DisplayName="Find existing row for Request ID" sap2010:WorkflowViewState.IdRef="Assign_1">
      <Assign.To>
        <OutArgument x:TypeArguments="sd:DataRow">[drRow]</OutArgument>
      </Assign.To>
      <Assign.Value>
        <InArgument x:TypeArguments="sd:DataRow">[dtReport.AsEnumerable().FirstOrDefault(Function(r) r("Request ID").ToString.Trim = in_RequestId)]</InArgument>
      </Assign.Value>
    </Assign>
    <If sap2010:Annotation.AnnotationText="New Request ID: create the row and add it to the table first; drRow points at the row inside the table, so the assignments below fill it in place." Condition="[drRow Is Nothing]" DisplayName="If Request ID not in report yet" sap2010:WorkflowViewState.IdRef="If_1">
      <If.Then>
        <Sequence DisplayName="Then" sap2010:WorkflowViewState.IdRef="Sequence_2">
          <Assign DisplayName="Create new row" sap2010:WorkflowViewState.IdRef="Assign_2">
            <Assign.To>
              <OutArgument x:TypeArguments="sd:DataRow">[drRow]</OutArgument>
            </Assign.To>
            <Assign.Value>
              <InArgument x:TypeArguments="sd:DataRow">[dtReport.NewRow()]</InArgument>
            </Assign.Value>
          </Assign>
          <ui:AddDataRow ArrayRow="{x:Null}" DataRow="[drRow]" DataTable="[dtReport]" DisplayName="Add row to report table" sap2010:WorkflowViewState.IdRef="AddDataRow_1" />
        </Sequence>
      </If.Then>
    </If>
    <ui:MultipleAssign sap2010:Annotation.AnnotationText="Fills all 13 required columns. Values the transaction never reached stay empty. Tax and totals from checkout go into Confirmation Details (captured separately from the budget check, which used the list price)." DisplayName="Fill report row" sap2010:WorkflowViewState.IdRef="MultipleAssign_1">
      <ui:MultipleAssign.AssignOperations>
        <scg:List x:TypeArguments="ui:AssignOperation" Capacity="16">
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_1">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Request ID&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[in_RequestId]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_2">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Employee Name&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;EmployeeName&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_3">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Employee Email&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;EmployeeEmail&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_4">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Product Name&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;ProductName&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_5">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Original Price (USD)&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;OriginalPriceUSD&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_6">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Preferred Currency&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;PreferredCurrency&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_7">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Exchange Rate&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;ExchangeRate&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_8">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Converted Price&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;ConvertedPrice&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_9">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Purchase Limit&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;PurchaseLimit&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_10">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Final Status&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[in_FinalStatus]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_11">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Status Reason&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[in_StatusReason]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_12">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Confirmation Details&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[funcGet(&quot;Confirmation&quot;) &amp; If(funcGet(&quot;TaxUSD&quot;) &lt;&gt; &quot;&quot;, &quot; | Item total $&quot; &amp; funcGet(&quot;ItemTotalUSD&quot;) &amp; &quot;, Tax $&quot; &amp; funcGet(&quot;TaxUSD&quot;) &amp; &quot;, Total $&quot; &amp; funcGet(&quot;TotalUSD&quot;), &quot;&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
          <ui:AssignOperation sap2010:WorkflowViewState.IdRef="AssignOperation_13">
            <ui:AssignOperation.To>
              <OutArgument x:TypeArguments="x:Object">[drRow(&quot;Processing Timestamp&quot;)]</OutArgument>
            </ui:AssignOperation.To>
            <ui:AssignOperation.Value>
              <InArgument x:TypeArguments="x:Object">[Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)]</InArgument>
            </ui:AssignOperation.Value>
          </ui:AssignOperation>
        </scg:List>
      </ui:MultipleAssign.AssignOperations>
    </ui:MultipleAssign>
    <ui:WriteRange sap2010:Annotation.AnnotationText="Rewrites the whole sheet with headers: the simplest way to persist an updated row; fine at this volume." AddHeaders="True" DataTable="[dtReport]" DisplayName="Save processing report" sap2010:WorkflowViewState.IdRef="WriteRange_1" SheetName="[in_Config(&quot;ReportSheetName&quot;).ToString]" StartingCell="A1" WorkbookPath="[in_Config(&quot;ReportFilePath&quot;).ToString]" />
  </Sequence>
</Activity>
